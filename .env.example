# No node is built into this repository: everything it talks to is named here.
# These are a local zvm-devnet's, at its default address
# (https://github.com/Zenoglyphs-VM/zvm-devnet).
# Copy this file to .env and change what you need; .env is kept out of git.

# --- The prober
# The gateway as this process reaches it, and the Host header to ask it for.
STATUS_ORIGIN=http://localhost:47080
# STATUS_HOST=
# The public URL, checked through the CDN (optional), and the base URL alert
# emails name.
# STATUS_EDGE=
STATUS_PUBLIC=http://localhost:47080
# The relayer and the bridge, which are not public (optional).
# STATUS_RELAYER=
# STATUS_BRIDGE=
# The Telegram bots' pages to check, comma-separated (rain,bullet); a
# zvm-devnet runs neither.
# STATUS_BOTS=
# Alerts, through an SMTP relay with a login. ALERT_TO is comma-separated.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_TO=

# --- The page (read at build time)
# A ZVM node's base URL: its JSON-RPC is at /rpc and its read API at /api.
VITE_ZVM_NODE=http://localhost:47080/zvm
# Where the explorer, Glyphswap and the other apps are, for links.
VITE_GATEWAY=http://localhost:47080
# The NoM node the wallet panel names (Syrius takes ws:// or wss:// only).
VITE_NOM_NODE=ws://localhost:47080/zenon
